# ═══════════════════════════════════════════════════════════
# FLEET OS - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════

# Supabase Configuration
SUPABASE_URL=https://hnypmigzwfavwcwarmnk.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# QuickBooks OAuth Configuration
QB_CLIENT_ID=your_qb_client_id_here
QB_CLIENT_SECRET=your_qb_client_secret_here
QB_ENVIRONMENT=sandbox  # or 'production' for live QuickBooks

# QuickBooks Webhook Configuration
# Generate with: openssl rand -base64 32
QB_WEBHOOK_TOKEN=your_random_secure_webhook_token_here

# Netlify Configuration
URL=https://your-domain.netlify.app  # or http://localhost:8888 for local dev

# ═══════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════
#
# 1. Copy this file to .env.local
# 2. Fill in all values above
# 3. Never commit .env.local to git
# 4. For production, set these in Netlify environment variables
#
# See QUICKBOOKS_SETUP.md for detailed setup instructions
