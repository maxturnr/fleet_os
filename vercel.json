{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "files",
  "rewrites": [
    {
      "source": "/",
      "destination": "/FleetOS_v3.html"
    },
    {
      "source": "/(.*)",
      "destination": "/FleetOS_v3.html"
    }
  ],
  "crons": [
    {
      "path": "/api/qb/sync",
      "schedule": "0 6 * * *"
    }
  ]
}