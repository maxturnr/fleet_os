{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "files",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/FleetOS_v2.html"
    },
    {
      "source": "/(.*)",
      "destination": "/FleetOS_v2.html"
    }
  ]
}
